# Copia a .env en la raíz. No subas secretos.

# local (PGlite, sin Docker) | supabase
DATA_DRIVER=local
# Obligatorio si NODE_ENV=production. En local se usa un secreto de desarrollo si falta.
JWT_SECRET=
# Correos separados por coma. Vacío = nadie es administrador de plataforma.
PLATFORM_ADMIN_EMAILS=
CORS_ORIGIN=http://localhost:5173
PORT=3000

# Cuando pases a Supabase, comenta DATA_DRIVER y define:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# AUTH_DRIVER=supabase usa Supabase Auth (correo y Google). El registro crea la cuenta ya confirmada, sin correo de verificación. El front lee SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY.
# En el dashboard: Authentication → URL Configuration, agrega http://localhost:5173/auth/callback
# Authentication → Providers → Google, con el callback https://[ref].supabase.co/auth/v1/callback
# SUPABASE_URL=https://[ref].supabase.co
# Llave publicable (sb_publishable_...). Solo el front. Reemplaza a la anon key.
# SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (sb_secret_...). Solo la API. Reemplaza a service_role.
# SUPABASE_SECRET_KEY=
# La API verifica el JWT del usuario con el JWKS del proyecto, no con el JWT secret legacy.
# DATA_DRIVER solo puede ser local fuera de production.
AUTH_DRIVER=local